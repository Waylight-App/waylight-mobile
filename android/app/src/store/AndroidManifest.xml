<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Asked at runtime on Android 13 and later, only when the person turns
         notifications on (ADR 0008). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Receives the end-to-end encrypted messages of the push relay. -->
        <service
            android:name=".push.WaylightMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
